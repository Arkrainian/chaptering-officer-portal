# Copy this file to .env and fill in your Supabase project's values.
# Find these under Project Settings > API in the Supabase dashboard.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The transcript summarizer runs in a Supabase Edge Function (supabase/functions/summarize-transcript)
# so the key never reaches the browser. Set it on your Supabase project, not here:
#   supabase secrets set GEMINI_API_KEY=AIza...
